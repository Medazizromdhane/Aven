# ---- Core ----
NODE_ENV=development
BACKEND_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---- Database (PostgreSQL / Supabase) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/visahunter?schema=public"

# ---- Redis (Upstash) for BullMQ ----
REDIS_URL="redis://localhost:6379"

# ---- Auth (JWT) ----
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ---- LLM: Mistral (primary) ----
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-large-latest"
MISTRAL_SMALL_MODEL="mistral-small-latest"

# Optional fallbacks (leave empty if unused)
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""

# ---- Job Search APIs ----
# Greenhouse & Lever are per-company public boards (no key needed) — configured per board token.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
RAPIDAPI_KEY=""            # for JSearch
THEMUSE_API_KEY=""         # optional, higher rate limits

# ---- Storage (Supabase S3, Cloudflare R2, or another S3-compatible service) ----
# Required in production. For Supabase use:
# https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="visahunter"
STORAGE_REGION="auto"
STORAGE_FORCE_PATH_STYLE="false"
# Legacy Cloudflare R2 names are still supported.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="visahunter"
R2_PUBLIC_URL=""

# ---- Email (Resend) ----
RESEND_API_KEY=""
EMAIL_FROM="VisaHunter AI <noreply@visahunter.ai>"

# ---- Frontend (Next.js public vars) ----
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Google OAuth (optional) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# ---- Cloudflare Turnstile anti-bot protection (optional locally, recommended in production) ----
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
