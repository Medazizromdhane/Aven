# ---- Core ----
NODE_ENV=development
BACKEND_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---- Database (PostgreSQL / Supabase) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/visahunter?schema=public"

# ---- Redis (Upstash) for BullMQ ----
REDIS_URL="redis://localhost:6379"

# ---- Auth (JWT) ----
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ---- LLM: Groq (OpenAI-compatible) ----
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_SMALL_MODEL="openai/gpt-oss-120b"

# Optional fallbacks (leave empty if unused)
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""

# ---- Job Search APIs ----
# Greenhouse & Lever are per-company public boards (no key needed) — configured per board token.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
RAPIDAPI_KEY=""            # JSearch = Google Jobs / LinkedIn / Indeed aggregation
THEMUSE_API_KEY=""         # optional, higher rate limits
THEMUSE_PAGES="4"          # optional, pages to crawl per hunt
# Optional: widen the keyless boards (comma-separated tokens/companies).
GREENHOUSE_BOARDS=""
LEVER_COMPANIES=""

# ---- Storage (Supabase S3, Cloudflare R2, or another S3-compatible service) ----
# Required in production. For Supabase use:
# https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="visahunter"
# Supabase: set to your project's real region (Storage → S3 access), e.g. eu-central-1.
# "auto" only works for Cloudflare R2 and breaks Supabase uploads.
STORAGE_REGION="auto"
STORAGE_FORCE_PATH_STYLE="false"

# ---- Keep-alive (Render free tier) ----
# The backend self-pings /api/health to avoid ~15 min idle spin-down.
KEEP_ALIVE_ENABLED="true"
KEEP_ALIVE_INTERVAL_MS="600000"
# Legacy Cloudflare R2 names are still supported.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="visahunter"
R2_PUBLIC_URL=""

# ---- Email (Resend) ----
RESEND_API_KEY=""
EMAIL_FROM="VisaHunter AI <noreply@visahunter.ai>"

# ---- Frontend (Next.js public vars) ----
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Google OAuth (optional) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# ---- Cloudflare Turnstile anti-bot protection (optional locally, recommended in production) ----
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
